# Copy to .env (or .env.local) and fill in.

# Which endpoint serves AI calls: "anthropic" (default) or "wellflow".
# Model ids, prices and supported features per provider live in src/lib/ai/providers.ts.
AI_PROVIDER=wellflow

# Key for the provider above. Wellflow keys start with wf_ (account menu > API keys).
WELLFLOW_API_KEY=
ANTHROPIC_API_KEY=

# Postgres connection string: Supabase > Connect > Session pooler (the direct
# db.<project>.supabase.co host is IPv6-only).
DATABASE_URL=

# Supabase Auth. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: public origin used in links inside auth emails (defaults to the request origin).
# SITE_URL=https://your-domain.com

# Optional: raises the GitHub API limit for portfolio reviews (60 requests/hour without it).
# GITHUB_TOKEN=

# Optional: answering practice interviews by voice (Deepgram speech-to-text).
# DEEPGRAM_API_KEY=
